+vec3 stone_mist_dissolve(vec3 stone,vec3 p,vec3 n){
+	// Gentle aerial mist veil on deep mountain roots (-5.2m .. -11.8m) so colossal keels melt poetically into clouds:
+	float wave=sin(p.x*.14+p.z*.12)*.42+cos(p.x*.25-p.z*.19)*.18;
+	float mist_t=smoothstep(-5.0+wave,-11.6+wave,p.y);
+	float haze=clamp(pow(mist_t,1.18)*.48,0.0,.48);
+	return mix(stone,stone_mist_color,haze);
+}
+
+// Root veil. The island stands in a sunlit cloud sea, so its lower walls are seen
+// through drifting mist: stone and its facet shading ease to the mist tone, and
+// below the floor the rock frays away like a dry brush running
+// out of pigment. Slab feet that end at different depths then stop reading as a
+// stepped dark skirting, and tall faces gain a value gradient from crisp top to
+// soft root. World anchored, a few ALU per fragment, no texture tap; the fray
+// noise only runs inside the last band. Set root_veil_strength to 0 to disable.
+uniform float root_veil_strength : hint_range(0.0, 1.0) = 1.0;
+const float ROOT_VEIL_TOP = -2.5;
+const float ROOT_VEIL_FLOOR = -5.7;
+float stone_root_veil(vec3 p){
+	float wave=sin(p.x*.14+p.z*.12)*.42+cos(p.x*.25-p.z*.19)*.18;
+	float t=clamp((ROOT_VEIL_TOP+wave-p.y)/(ROOT_VEIL_TOP-ROOT_VEIL_FLOOR),0.0,1.0);
+	// Stone holds its weight through the upper half, then gives way quickly.
+	float v=t*t*(3.0-2.0*t);
+	return root_veil_strength*v*(.38+.62*v);
+}
+bool stone_root_frayed(vec3 p,float veil){
+	if(veil<.80)return false;
+	// Tall narrow wisps, so the lower edge breaks into strokes, not into dots.
+	float wisp=stone_noise(vec3(p.x*1.15,p.y*.42,p.z*1.15)+vec3(1.7,4.2,8.3));
+	return (veil-.80)*5.0>wisp;
+}
+// Inside the veil a face shows the palette mist tone itself, unlit, the way the
+// cloud deck and the waterfall spray do, so it follows every hour of the day.
+void stone_root_veil_apply(float veil,inout vec3 albedo,inout vec3 emission){
+	float m=veil*.90;
+	albedo*=1.0-m;
+	emission+=stone_mist_color*m;
+}
+
+float stone_lip_ao(vec3 p,vec3 n,float cap_height,float dry){
+	if(dry<.5)return 0.0;
+	float depth=cap_height-p.y;
+	if(depth<-.04 || depth>.24)return 0.0;
+	float lip_noise=stone_noise(vec3(p.x*1.1,p.y*1.0,p.z*1.1));
+	float band=(1.0-smoothstep(.008,.085+.065*lip_noise,max(0.0,depth)))*(.65+.35*lip_noise);
+	return clamp(band*smoothstep(.70,-.30,n.y),0.0,1.0);

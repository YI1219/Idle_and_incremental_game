+ // taps for a mean change under 0.13/255 in stills (2026-11-21). Balanced
+ // preview quality sets stone_fine_relief to 0 and skips it; native keeps it.
+ if(stone_relief_strength*stone_fine_relief<=0.0)return n;
+ float e=.10;
+ float h=stone_noise(p*.95);
+ vec3 g=vec3(stone_noise((p+vec3(e,0,0))*.95)-h,
+             stone_noise((p+vec3(0,e,0))*.95)-h,
+             stone_noise((p+vec3(0,0,e))*.95)-h)/e;

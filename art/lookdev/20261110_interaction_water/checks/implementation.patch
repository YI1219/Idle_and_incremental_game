+			var measured: Dictionary = _nearest_outflow(Vector2(veil.lip.x, veil.lip.z), veil.out)
+			veil.rate = measured.get("rate", 0.0)
+			veil.intensity = clampf(float(veil.rate) / 0.45, 0.0, 1.0)
+		for splash: Dictionary in splash_points:

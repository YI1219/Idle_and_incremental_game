+			var neighbor: Vector2i = cell + direction
+			if basin_ids.get(neighbor, -1) != basin_ids[cell] or float(distances.get(neighbor, 0.0)) <= next:
+				continue
+			distances[neighbor] = next
+			queue.append(neighbor)

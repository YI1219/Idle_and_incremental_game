+		flow.step(duration)
+	var solved: int = Time.get_ticks_usec()
+	var field: FlowField = FlowField.new()
+	field.build_live(snapshot, flow)
+	var meshes: Dictionary = {}
+	for kind: String in WATER_LAYERS:

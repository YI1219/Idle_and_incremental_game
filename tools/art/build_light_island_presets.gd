extends 'res://tools/art/capture_island_proportion.gd'
## Same already-reviewed shallow data rule, now all4 authored source cases.
const Preset=preload('res://scripts/terrain_editor/island_preset.gd')
func run():
 var out:='res://assets/terrain_editor/island_presets_light/'
 var work:='res://art/work/retained_island/2026-10-19/light/'
 for name:String in ['courtyard_7301','courtyard_7319','bay_7301','bay_7319']:
  if FileAccess.file_exists(out+name+'.res'):push_error('Preserve light presets');quit(1);return
 DirAccess.make_dir_recursive_absolute(out);DirAccess.make_dir_recursive_absolute(work)
 editor=load('res://scenes/beautiful_island.tscn').instantiate();root.add_child(editor)
 editor.set_process(false);editor.camera.set_process(false)
 var reports:Dictionary={}
 for i in editor.CASES.size():
  editor.select_preset(i)
  var name:String=editor.CASES[i];var rule:=compressed_data()
  var payload:Dictionary=editor.data.serialize()
  var resource:=Preset.new();resource.layout=payload
  var error:=ResourceSaver.save(resource,out+name+'.res',ResourceSaver.FLAG_COMPRESS);assert(error==OK)
  var folder:=work+name+'/';DirAccess.make_dir_recursive_absolute(folder+'output_geometry/')
  var vertices:PackedVector3Array=editor.renderer.contours.surfaces.sculpted_terrain.vertices
  FileAccess.open(folder+'candidate.layout',FileAccess.WRITE).store_string(JSON.stringify(payload,'',true,true))
  FileAccess.open(folder+'output_geometry/playable.bin',FileAccess.WRITE).store_buffer(vertices.to_byte_array())
  reports[name]={'rule':rule,'source_preset_sha256':FileAccess.get_sha256('res://assets/terrain_editor/island_presets/'+name+'.res'),'runtime_resource_sha256':FileAccess.get_sha256(out+name+'.res'),'vertex_sha256':digest(vertices.to_byte_array()),'triangles':vertices.size()/3,'records':editor.data.rocks.samples.size(),'cells':editor.data.cells.size(),'version':payload.version,'art_accepted':false}
  print('LIGHT PRESET: ',name,' records=',editor.data.rocks.samples.size(),' tri=',vertices.size()/3)
 FileAccess.open(work+'manifest.json',FileAccess.WRITE).store_string(JSON.stringify({'cases':reports,'scope':'Four ordinary v4data resources generated by the same.52vertical compression reviewed on courtyard7301. Original resources preserved; not arbitrary-contour runtime compilation. Functional/visual acceptance separate.'},'\t',true,true))
 editor.queue_free();quit()
